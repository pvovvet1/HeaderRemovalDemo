<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Header Removal Demo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="12dp" />

        <!-- Custom URL Input Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Custom URL Test"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/customUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter URL (e.g., httpbin.org/headers)"
            android:inputType="textUri"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <!-- Request Method Selection -->
        <RadioGroup
            android:id="@+id/requestMethodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radioGet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GET"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioPost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="POST" />
        </RadioGroup>

        <!-- POST Data Input (hidden by default) -->
        <EditText
            android:id="@+id/postDataInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="POST data (e.g., key=value&foo=bar)"
            android:inputType="text"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Test Custom URL"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Quick Test URLs -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Quick Test URLs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/testHttpBinHeaders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Headers"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/testHttpBinGet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GET Test"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/testHttpBinUserAgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="User-Agent"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/testIpify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IP Check"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Header Removal Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑️ Headers to Remove"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/removeXRequestedWith"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="X-Requested-With (Android WebView identifier)"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/removeUserAgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User-Agent (Browser identifier)"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/removeReferer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Referer (Origin tracking)"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/removeSecHeaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sec-Ch-* (Client hints headers)"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Custom Header Addition -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Add Custom Header"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/customHeaderKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Header name"
                android:inputType="text"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/customHeaderValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Header value"
                android:inputType="text"
                android:padding="12dp"
                android:background="#F5F5F5" />
        </LinearLayout>

        <!-- Logs Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Request Logs"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/clearLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="Logs will appear here..."
            android:background="#F5F5F5"
            android:padding="12dp"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:layout_marginBottom="12dp" />

        <!-- WebView -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Response Viewer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
